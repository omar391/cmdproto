{
  "name": "cmdproto-greeter-consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "cmdproto:gen": "cmdproto-build --generate-only",
    "cmdproto:schema": "cmdproto-build --app-name greeter",
    "cmdproto:run": "npm run cmdproto:schema --silent && tsx src/cmdproto/app.mts",
    "check": "npm run cmdproto:gen && npm run cmdproto:schema && npm run cmdproto:run -- greet Ada -s && npm run cmdproto:run -- cmdproto execjson greet '{\"name\":\"Ada\",\"shout\":true}'"
  },
  "dependencies": {
    "cmdproto": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
