{
  "name": "cmdproto",
  "version": "0.1.0",
  "description": "Proto-first ABI boundary toolkit for strict human and machine command interfaces.",
  "type": "module",
  "bin": {
    "cmdproto": "./scripts/cmdproto.mjs",
    "cmdproto-buf-plugin": "./scripts/buf-plugin-cmdproto",
    "cmdproto-runtime-manifest": "./scripts/runtime-manifest.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/runtimes/runtime.d.ts",
      "import": "./dist/runtimes/runtime.js"
    }
  },
  "files": [
    "README.md",
    "dist/runtimes",
    "dist/wasm",
    "proto",
    "scripts/cmdproto.mjs",
    "scripts/lib",
    "scripts/buf-plugin-cmdproto",
    "scripts/run-wasi.mjs",
    "scripts/runtime-manifest.mjs"
  ],
  "scripts": {
    "build:wasm": "mkdir -p dist/wasm && cd tools/buf-plugin-cmdproto && GOOS=wasip1 GOARCH=wasm go build -o ../../dist/wasm/cmdproto-buf-plugin.wasm ./cmd/buf-plugin-cmdproto && GOOS=wasip1 GOARCH=wasm go build -o ../../dist/wasm/cmdproto-runtime-manifest.wasm ./cmd/runtime-manifest",
    "schema:build": "node ./scripts/cmdproto.mjs build --app-name app",
    "schema:build:greeter": "node ./scripts/cmdproto.mjs build --app-name greeter --proto examples/greeter/proto --out-dir examples/greeter/dist",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:plugin": "cd tools/buf-plugin-cmdproto && go test ./...",
    "example:greeter": "npm run schema:build:greeter --silent && tsx examples/greeter/src/app.ts",
    "check": "npm run build:wasm && buf lint && npm run schema:build && npm run schema:build:greeter && npm run build && npm test && npm run test:plugin"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
